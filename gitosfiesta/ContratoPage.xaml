<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="gitosfiesta.ContratoPage"
             Title="Contrato Gitos Fiesta"
                          Shell.NavBarIsVisible="False"

             BackgroundColor="#FFFFFF">

    <ScrollView>
        <!-- Contenedor principal centrado y fluido para Laptop y Celular -->
        <VerticalStackLayout Spacing="15" Padding="24" MaximumWidthRequest="950" HorizontalOptions="Fill">

            <!-- ENCABEZADO: IMAGEN MÁS ANCHA Y PEGADA AL MARGEN -->
            <VerticalStackLayout Spacing="0" Margin="0,0,0,5">

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" Margin="0">

                    <!-- Espacio de equilibrio a la izquierda -->
                    <BoxView Grid.Column="0" BackgroundColor="Transparent" WidthRequest="120" HeightRequest="1"/>

                    <!-- Logo más ancho y con margen negativo profundo para eliminar el espacio sobrante -->
                    <Image Grid.Column="1" Source="imagen2.png" WidthRequest="400" HeightRequest="250" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-35,0,-105"/>

                    <!-- Folio a la derecha alineado a la misma altura -->
                    <Frame Grid.Column="2" BackgroundColor="#F8F9FA" CornerRadius="10" Padding="12,6" BorderColor="#CBD5E1" HasShadow="False" VerticalOptions="Center" HorizontalOptions="End">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Folio:" FontAttributes="Bold" TextColor="#1E293B" VerticalOptions="Center" FontSize="13"/>
                            <Label x:Name="LblFolio" Text="---" FontAttributes="Bold" TextColor="#E91E63" FontSize="15" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>

                </Grid>

                <!-- Línea Turquesa pegada perfectamente abajo del logo -->

            </VerticalStackLayout>

            <!-- Datos Generales Estilo Contrato (Tarjeta Principal) -->
            <Border BackgroundColor="#F8F9FA" Stroke="#EAE4DC" StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <shapes:RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <!-- Fecha Contrato -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Fecha de contrato:" FontAttributes="Bold" TextColor="#1E293B" FontSize="13"/>
                        <Label x:Name="LblFechaContrato" Text="---" TextColor="#475569" FontSize="13"/>
                    </HorizontalStackLayout>

                    <!-- Nombre y Teléfono -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Nombre:" FontAttributes="Bold" TextColor="#1E293B" FontSize="13"/>
                            <Label x:Name="LblNombre" Text="---" TextColor="#475569" LineBreakMode="WordWrap" FontSize="13"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Tel/Cel:" FontAttributes="Bold" TextColor="#1E293B" FontSize="13"/>
                            <Label x:Name="LblTelefono" Text="---" TextColor="#475569" FontSize="13"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Evento, Fecha y Hora -->
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Evento:" FontAttributes="Bold" TextColor="#1E293B" FontSize="12"/>
                            <Label x:Name="LblEvento" Text="---" TextColor="#475569" FontSize="12"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Fecha:" FontAttributes="Bold" TextColor="#1E293B" FontSize="12"/>
                            <Label x:Name="LblFechaEvento" Text="---" TextColor="#475569" FontSize="12"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="Hora:" FontAttributes="Bold" TextColor="#1E293B" FontSize="12"/>
                            <Label x:Name="LblHora" Text="---" TextColor="#475569" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Personas y Menú -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="No. personas:" FontAttributes="Bold" TextColor="#1E293B" FontSize="13"/>
                            <Label x:Name="LblPersonas" Text="---" TextColor="#475569" FontSize="13"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Menú:" FontAttributes="Bold" TextColor="#1E293B" FontSize="13"/>
                            <Label x:Name="LblMenu" Text="---" TextColor="#475569" LineBreakMode="WordWrap" FontSize="13"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Precio, Anticipo y Saldo (Con tonos pasteles corporativos) -->
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" BackgroundColor="#DCE8F0" Padding="8">
                            <Label Text="Precio:" FontAttributes="Bold" TextColor="#1E3A8A" FontSize="12"/>
                            <Label x:Name="LblPrecio" Text="---" TextColor="#1E3A8A" FontSize="12" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" BackgroundColor="#F4F0DC" Padding="8">
                            <Label Text="Anticipo:" FontAttributes="Bold" TextColor="#713F12" FontSize="12"/>
                            <Label x:Name="LblAnticipo" Text="---" TextColor="#713F12" FontSize="12" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2" BackgroundColor="#F0DCE2" Padding="8">
                            <Label Text="Saldo:" FontAttributes="Bold" TextColor="#881337" FontSize="12"/>
                            <Label x:Name="LblSaldo" Text="---" TextColor="#BE123C" FontAttributes="Bold" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Promoción y Observaciones -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Promoción:" FontAttributes="Bold" TextColor="#1E293B" FontSize="13"/>
                        <Label x:Name="LblPromocion" Text="---" TextColor="#475569" FontSize="13"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="2" Margin="0,2,0,0">
                        <Label Text="OBSERVACIONES:" FontAttributes="Bold" TextColor="#1E293B" FontSize="12"/>
                        <Label x:Name="LblObservaciones" Text="Ninguna" TextColor="#475569" FontSize="12"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Términos y Condiciones -->
            <VerticalStackLayout Spacing="8" Margin="0,5,0,5">
                <Label Text="Términos y Condiciones" FontAttributes="Bold" TextColor="#1B1464" HorizontalOptions="Center" FontSize="15"/>
                <Label x:Name="LblTerminos" Text="Cargando términos..." FontSize="12" TextColor="#334155" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <!-- Sección de Firma -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,5,0,5">
                <Label Text="Firma del Cliente" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center" FontSize="14"/>

                <Border HeightRequest="130" WidthRequest="320" Padding="0" BackgroundColor="#F8F9FA" Stroke="#CBD5E1" StrokeThickness="1">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Image x:Name="ImgFirma" Aspect="AspectFit"/>
                </Border>

                <Button Text="✍️ Abrir Pizarrón de Firma" 
                        BackgroundColor="#64748B" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="10" 
                        HeightRequest="42"
                        Clicked="OnAbrirPizarronClicked"/>
            </VerticalStackLayout>

            <!-- Pie de Página Institucional Moderno (Sin franja morada) -->
            <Border BackgroundColor="#F1F5F9" Stroke="#E2E8F0" StrokeThickness="1" Padding="12" Margin="0,5,0,5">
                <Border.StrokeShape>
                    <shapes:RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                    <Label Text="16 de Agosto No. 101-D, Col. Reserva de San Roque, Esquina con prolongación Pablo Livas, Juárez N.L." 
                           TextColor="#475569" FontSize="10" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                        <Label Text="Cel/Whatsapp: 8119887387" TextColor="#1E293B" FontSize="10" FontAttributes="Bold"/>
                        <Label Text="facebook/GitosFiesta" TextColor="#1E293B" FontSize="10" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Botones Cancelar y Guardar -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,5,0,15">
                <Button Grid.Column="0" 
                        Text="❌ Cancelar" 
                        BackgroundColor="#EF4444" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="14"
                        CornerRadius="10" 
                        HeightRequest="48"
                        Clicked="OnCancelarClicked"/>

                <Button Grid.Column="1" 
                        Text="Guardar y Finalizar" 
                        BackgroundColor="#1B1464" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="14"
                        CornerRadius="10" 
                        HeightRequest="48"
                        Clicked="OnFinalizarContratoClicked"/>
            </Grid>

            <!-- Botón para generar y compartir PDF -->
            <Button Text="Generar y compartir PDF"
                    Clicked="OnGenerarPdfClicked"
                    BackgroundColor="#1B1464"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="10"
                    Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>