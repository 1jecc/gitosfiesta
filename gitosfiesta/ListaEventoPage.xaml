<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"

             x:Class="gitosfiesta.ListaEventoPage"
             Title="Lista de Eventos"
             Shell.NavBarIsVisible="False"

             BackgroundColor="#fff">


        <Grid RowDefinitions="Auto, *" Padding="16">

        <!-- ========================================== -->
        <!-- VISTA 1: PANEL DE FILTROS Y LISTA GENERAL -->
        <!-- ========================================== -->
        <!-- ========================================== -->
        <!-- VISTA 1: PANEL DE FILTROS Y LISTA GENERAL  -->
        <!-- ========================================== -->
        <Grid x:Name="PanelLista" Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto, *">

            <!-- Panel de Filtros Superiores (Fijo arriba) -->
            <Frame Grid.Row="0" BackgroundColor="White" CornerRadius="12" HasShadow="True" Padding="15" Margin="0,0,0,15" BorderColor="#00D2C4">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Buscar y Filtrar Eventos" FontAttributes="Bold" FontSize="14" TextColor="#2D3748"/>

                    <!-- Búsqueda por Nombre -->
                    <Frame CornerRadius="8" Padding="8,2" HeightRequest="42" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#CBD5E0">
                        <Entry x:Name="TxtBuscarNombre" 
                               Placeholder="🔍 Buscar por nombre del cliente..." 
                               TextColor="#333" 
                               BackgroundColor="Transparent" 
                               TextChanged="OnFiltroCombinadoChanged"
                               VerticalOptions="Center"/>
                    </Frame>

                    <!-- Filtros desplegables y Fechas -->
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" ColumnSpacing="10" RowSpacing="10">

                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="Vigencia" FontSize="11" TextColor="#718096" FontAttributes="Bold"/>
                            <Frame CornerRadius="8" Padding="6,2" HeightRequest="42" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#CBD5E0">
                                <Picker x:Name="PickerFiltro" TextColor="#333" BackgroundColor="Transparent" SelectedIndexChanged="OnFiltroCombinadoChanged" VerticalOptions="Center">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Vigentes</x:String>
                                            <x:String>Caducados</x:String>
                                            <x:String>Todos</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                            <Label Text="Estatus" FontSize="11" TextColor="#718096" FontAttributes="Bold"/>
                            <Frame CornerRadius="8" Padding="6,2" HeightRequest="42" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#CBD5E0">
                                <Picker x:Name="PickerEstatus" TextColor="#333" BackgroundColor="Transparent" SelectedIndexChanged="OnFiltroCombinadoChanged" VerticalOptions="Center">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Todos los estatus</x:String>
                                            <x:String>Abierto y por pagar</x:String>
                                            <x:String>Liquidado</x:String>
                                            <x:String>Cancelado</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                            <Label Text="Desde (±15d)" FontSize="11" TextColor="#718096" FontAttributes="Bold"/>
                            <Frame CornerRadius="8" Padding="6,2" HeightRequest="42" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#CBD5E0">
                                <DatePicker x:Name="DatePickerDesde" TextColor="#333" BackgroundColor="Transparent" DateSelected="OnFiltroCombinadoChanged" VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Text="Hasta" FontSize="11" TextColor="#718096" FontAttributes="Bold"/>
                            <Frame CornerRadius="8" Padding="6,2" HeightRequest="42" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#CBD5E0">
                                <DatePicker x:Name="DatePickerHasta" TextColor="#333" BackgroundColor="Transparent" DateSelected="OnFiltroCombinadoChanged" VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Colección de Eventos (Con scroll independiente y fluida sin bloqueos) -->
            <CollectionView x:Name="ColeccionEventos" 
                            Grid.Row="1"
                            SelectionMode="Single" 
                            SelectionChanged="OnEventoSelected">
                <CollectionView.EmptyView>
                    <Label Text="No se encontraron eventos con los filtros seleccionados." HorizontalOptions="Center" VerticalOptions="Center" TextColor="#888" FontSize="14"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" CornerRadius="12" HasShadow="True" Padding="15" Margin="0,0,0,12" BorderColor="#00D2C4">
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding nombre_cliente}" FontAttributes="Bold" FontSize="15" TextColor="#2D3748"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding fecha_evento, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#00D2C4" FontSize="13"/>
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding tipo_evento}" FontSize="13" TextColor="#718096" Margin="0,4,0,0"/>
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding estatus}" FontSize="12" TextColor="#E53E3E" FontAttributes="Bold" Margin="0,6,0,0"/>
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding precio, StringFormat='${0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#2B6CB0" VerticalOptions="End"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>


        <!-- ========================================== -->
        <!-- VISTA 2: PANEL DE DETALLE DEL EVENTO       -->
        <!-- ========================================== -->
        <ScrollView x:Name="PanelDetalle" Grid.Row="0" Grid.RowSpan="2" IsVisible="False">
            <VerticalStackLayout Spacing="16" Padding="5" MaximumWidthRequest="950" HorizontalOptions="Fill">

                <!-- CABECERA SUPERIOR ADAPTABLE (Botón regresar y acciones en WrapLayout/FlexLayout) -->
                <VerticalStackLayout Spacing="10">

                    <!-- Regresar -->
                    <Button Text="⬅️ Regresar a la lista" 
                            BackgroundColor="#4A5568" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="10" 
                            HeightRequest="42"
                            WidthRequest="180"
                            HorizontalOptions="Start"
                            Clicked="OnRegresarClicked"/>

                    <!-- Botones de Acción Superiores (Usando FlexLayout para que bajen de renglón automáticamente en celular) -->
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Button Text="Ver Contrato" BackgroundColor="#607D8B" TextColor="White" FontAttributes="Bold" FontSize="12" CornerRadius="10" HeightRequest="40" Margin="0,0,8,8" Clicked="OnVerContratoDetalleClicked"/>

                        <Button x:Name="BtnModificarEvento" Text="Modificar Evento" BackgroundColor="#eb6565" TextColor="White" FontAttributes="Bold" FontSize="12" CornerRadius="10" HeightRequest="40" IsVisible="False" Margin="0,0,8,8" Clicked="OnModificarEventoClicked"/>

                        <Button x:Name="BtnGuardarModificacion" Text="Guardar Cambios" BackgroundColor="#a6c5d9" TextColor="White" FontAttributes="Bold" FontSize="12" CornerRadius="10" HeightRequest="40" IsVisible="False" Margin="0,0,8,8" Clicked="OnGuardarModificacionClicked"/>

                        <Button x:Name="BtnCancelarEdicion" Text="Cancelar" BackgroundColor="#E53E3E" TextColor="White" FontAttributes="Bold" FontSize="12" CornerRadius="10" HeightRequest="40" IsVisible="False" Margin="0,0,8,8" Clicked="OnCancelarEdicionClicked"/>

                        <Button x:Name="BtnAsignarPersonal" Text="Asignar Personal" BackgroundColor="#319795" TextColor="White" FontAttributes="Bold" FontSize="12" CornerRadius="10" HeightRequest="40" Margin="0,0,8,8" Clicked="OnAsignarPersonalClicked"/>

                        <Button Text="Comentarios" BackgroundColor="#d6c82e" TextColor="White" FontAttributes="Bold" FontSize="12" CornerRadius="10" HeightRequest="40" Margin="0,0,8,8" Clicked="OnAgregarComentariosClicked"/>

                        <Button Text="Realizar Pago" BackgroundColor="#3fb475" TextColor="White" FontAttributes="Bold" FontSize="12" CornerRadius="10" HeightRequest="40" Margin="0,0,8,8" Clicked="OnRealizarPagoClicked"/>
                    </FlexLayout>

                </VerticalStackLayout>

                <!-- Tarjeta Principal de Detalles -->
                <Frame BackgroundColor="White" BorderColor="#00D2C4" CornerRadius="16" HasShadow="True" Padding="20">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Detalles del Evento" FontAttributes="Bold" FontSize="20" TextColor="#2D3748"/>
                            <BoxView HeightRequest="3" BackgroundColor="#00D2C4" WidthRequest="60" CornerRadius="2" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Fila 1: Folio y Fecha Contrato -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <Frame Grid.Column="0" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="FOLIO" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleFolio" Text="---" TextColor="#2D3748" FontAttributes="Bold" FontSize="14"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="FECHA DE CONTRATO" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleFechaContrato" Text="---" TextColor="#2D3748" FontSize="13"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Fila 2: Cliente y Teléfono -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <Frame Grid.Column="0" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="CLIENTE" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleCliente" Text="---" TextColor="#2D3748" FontAttributes="Bold" FontSize="14"/>
                                    <Entry x:Name="TxtEditCliente" IsVisible="False" TextColor="#2D3748" FontSize="14" BackgroundColor="White"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="TELÉFONO" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleTelefono" Text="---" TextColor="#2D3748" FontSize="13"/>
                                    <Entry x:Name="TxtEditTelefono" IsVisible="False" TextColor="#2D3748" FontSize="13" Keyboard="Telephone" BackgroundColor="White"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Fila 3: Evento, Fecha y Hora -->
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                            <Frame Grid.Column="0" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="EVENTO" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleTipoEvento" Text="---" TextColor="#2D3748" FontSize="13"/>
                                    <Entry x:Name="TxtEditTipoEvento" IsVisible="False" TextColor="#2D3748" FontSize="13" BackgroundColor="White"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="FECHA" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleFechaEvento" Text="---" TextColor="#2D3748" FontSize="13"/>
                                    <DatePicker x:Name="DatePickerEditFechaEvento" IsVisible="False" TextColor="#2D3748" Format="dd/MM/yyyy" BackgroundColor="White"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="2" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="HORA" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleHora" Text="---" TextColor="#2D3748" FontSize="13"/>
                                    <TimePicker x:Name="TimePickerEditHoraEvento" IsVisible="False" TextColor="#2D3748" BackgroundColor="White"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Fila 4: Invitados y Estatus -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <Frame Grid.Column="0" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="NÚMERO DE PERSONAS" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetallePersonas" Text="---" TextColor="#2D3748" FontSize="13"/>
                                    <Entry x:Name="TxtEditPersonas" IsVisible="False" TextColor="#2D3748" FontSize="13" Keyboard="Numeric" BackgroundColor="White"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="ESTATUS" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleEstatus" Text="---" TextColor="#E53E3E" FontAttributes="Bold" FontSize="13"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Menú / Paquete -->
                        <Frame BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="MENÚ / PAQUETE" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                <Label x:Name="LblDetalleMenu" Text="---" TextColor="#2D3748" FontSize="13"/>
                                <Entry x:Name="TxtEditMenu" IsVisible="False" TextColor="#2D3748" FontSize="13" BackgroundColor="White"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Tarjeta de Costos (Adaptable a 2 columnas en celulares si es necesario, o se mantiene en Grid de 4 compacta) -->
                        <Frame BackgroundColor="#EDF2F7" BorderColor="#CBD5E0" CornerRadius="10" Padding="12" HasShadow="False">
                            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="6">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="PRECIO" FontAttributes="Bold" TextColor="#4A5568" FontSize="10"/>
                                    <Label x:Name="LblDetallePrecio" Text="---" TextColor="#2B6CB0" FontAttributes="Bold" FontSize="13"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="ANTICIPO" FontAttributes="Bold" TextColor="#4A5568" FontSize="10"/>
                                    <Label x:Name="LblDetalleAnticipo" Text="---" TextColor="#38A169" FontAttributes="Bold" FontSize="13"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="ABONOS" FontAttributes="Bold" TextColor="#4A5568" FontSize="10"/>
                                    <Label x:Name="LblDetalleAbonos" Text="---" TextColor="#319795" FontAttributes="Bold" FontSize="13"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3">
                                    <Label Text="SALDO" FontAttributes="Bold" TextColor="#E53E3E" FontSize="10"/>
                                    <Label x:Name="LblDetalleSaldo" Text="---" TextColor="#E53E3E" FontAttributes="Bold" FontSize="13"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>

                        <!-- Promoción -->
                        <Frame BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="PROMOCIÓN" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                <Label x:Name="LblDetallePromocion" Text="Ninguna" TextColor="#2D3748" FontSize="13"/>
                                <Entry x:Name="TxtEditPromocion" IsVisible="False" TextColor="#2D3748" FontSize="13" Placeholder="Opcional" BackgroundColor="White"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Observaciones -->
                        <Frame BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="OBSERVACIONES" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                <Label x:Name="LblDetalleObservaciones" Text="Ninguna" TextColor="#2D3748" FontSize="13"/>
                                <Editor x:Name="TxtEditObservaciones" IsVisible="False" TextColor="#2D3748" FontSize="13" HeightRequest="70" BackgroundColor="White"/>
                            </VerticalStackLayout>
                        </Frame>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>


        <!-- MODAL COMENTARIOS -->
        <Grid x:Name="ModalComentarios" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="False">
            <Frame BackgroundColor="#E2F2F4" CornerRadius="16" MaximumWidthRequest="450" HorizontalOptions="Center" VerticalOptions="Center" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Comentarios y Observaciones" FontAttributes="Bold" FontSize="18" TextColor="#333"/>
                    <Frame CornerRadius="10" Padding="10" BackgroundColor="White" BorderColor="#00D2C4">
                        <Editor x:Name="TxtModalComentarios" TextColor="#333" Placeholder="Escribe observaciones..." HeightRequest="140"/>
                    </Frame>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Guardar" BackgroundColor="#00D2C4" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="45" Clicked="OnGuardarComentarioModalClicked"/>
                        <Button Grid.Column="1" Text="Cancelar" BackgroundColor="#718096" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="45" Clicked="OnCancelarComentarioModalClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- ========================================== -->
        <!-- MODAL ABONOS (Estilo Sobrio y Corporativo) -->
        <!-- ========================================== -->
        <Grid x:Name="ModalAbonos" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="False">
            <ScrollView VerticalOptions="Center" HorizontalOptions="Center" Padding="15">
                <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" MaximumWidthRequest="480" Padding="24">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Módulo de Cobranza" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" TextColor="#64748B" FontAttributes="Bold" FontSize="16" HeightRequest="36" WidthRequest="36" Clicked="OnCerrarModalAbonosClicked" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Estado de Cuenta -->
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="16">
                            <Border.StrokeShape>
                                <shapes:RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Estado de Cuenta" FontAttributes="Bold" TextColor="#334155" FontSize="14" HorizontalOptions="Center"/>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="6">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Costo Total:" TextColor="#64748B" FontSize="13"/>
                                    <Label Grid.Row="0" Grid.Column="1" x:Name="LblModalCostoTotal" Text="$0.00" FontAttributes="Bold" TextColor="#1E293B" FontSize="13"/>

                                    <Label Grid.Row="1" Grid.Column="0" Text="Anticipo Inicial:" TextColor="#64748B" FontSize="13"/>
                                    <Label Grid.Row="1" Grid.Column="1" x:Name="LblModalAnticipo" Text="$0.00" FontAttributes="Bold" TextColor="#1E293B" FontSize="13"/>

                                    <Label Grid.Row="2" Grid.Column="0" Text="Abonos Acumulados:" TextColor="#64748B" FontSize="13"/>
                                    <Label Grid.Row="2" Grid.Column="1" x:Name="LblModalAbonosAcumulados" Text="$0.00" FontAttributes="Bold" TextColor="#1E293B" FontSize="13"/>
                                </Grid>

                                <Border BackgroundColor="#F1F5F9" Stroke="#CBD5E1" StrokeThickness="1" Padding="10">
                                    <Border.StrokeShape>
                                        <shapes:RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                        <Label Text="SALDO PENDIENTE:" FontAttributes="Bold" TextColor="#B91C1C" FontSize="13" VerticalOptions="Center"/>
                                        <Label x:Name="LblModalSaldoPendiente" Text="$0.00" FontAttributes="Bold" TextColor="#B91C1C" FontSize="16" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Registrar Nuevo Abono -->
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="16">
                            <Border.StrokeShape>
                                <shapes:RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Registrar Nuevo Abono" FontAttributes="Bold" TextColor="#334155" FontSize="14"/>
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,4,0,0">
                                    <!-- Columna Izquierda: Monto -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Monto ($)" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                        <Frame BorderColor="#CBD5E1" CornerRadius="8" Padding="8,4" BackgroundColor="White" HasShadow="False" HeightRequest="48">
                                            <Entry x:Name="TxtModalMontoAbono" Placeholder="0.00" Keyboard="Numeric" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                                        </Frame>
                                    </VerticalStackLayout>

                                    <!-- Columna Derecha: Método (Etiqueta y Picker alineados en la misma sección) -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Fill">
                                        <Label Text="Método" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>

                                        <Frame BorderColor="#CBD5E1" CornerRadius="8" Padding="10,0" BackgroundColor="White" HasShadow="False" HeightRequest="48" HorizontalOptions="Fill" VerticalOptions="Center">

                                            <!-- Quitamos el Title para evitar que se desbanque o se encime, y usamos VerticalOptions="Center" -->
                                            <Picker x:Name="PickerModalMetodo" 
                FontSize="14" 
                TextColor="#1E293B" 
                BackgroundColor="White" 
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                SelectedIndexChanged="PickerModalMetodo_SelectedIndexChanged">
                                                <Picker.Items>
                                                    <x:String>Efectivo</x:String>
                                                    <x:String>Transferencia</x:String>
                                                    <x:String>Tarjeta</x:String>
                                                </Picker.Items>
                                            </Picker>

                                        </Frame>
                                    </VerticalStackLayout>
                                </Grid>
                                <Button Text="Registrar Pago" BackgroundColor="#1E293B" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42" Clicked="OnRegistrarPagoModalClicked"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Historial de Abonos -->
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="16">
                            <Border.StrokeShape>
                                <shapes:RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Historial de Abonos" FontAttributes="Bold" TextColor="#334155" FontSize="14" HorizontalOptions="Center"/>
                                <CollectionView x:Name="ColeccionModalHistorial" HeightRequest="110">
                                    <CollectionView.EmptyView>
                                        <Label Text="Aún no hay abonos registrados." HorizontalOptions="Center" TextColor="#94A3B8" FontAttributes="Italic" FontSize="12"/>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*, Auto, Auto, Auto" Padding="0,4" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="{Binding FechaPago, StringFormat='{0:dd-MM-yyyy}'}" TextColor="#64748B" FontSize="12" VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding MetodoPago}" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding Monto, StringFormat='${0:F2}'}" FontAttributes="Bold" TextColor="#0F766E" FontSize="12" VerticalOptions="Center"/>
                                                <Button Grid.Column="3" Text="Ver PDF" FontSize="11" BackgroundColor="#475569" TextColor="White" CornerRadius="6" HeightRequest="30" Padding="8,0" CommandParameter="{Binding .}" Clicked="OnVerComprobanteAbonoClicked" VerticalOptions="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- ========================================== -->
        <!-- MODAL STAFF (Asignación Sobria)            -->
        <!-- ========================================== -->
        <Grid x:Name="ModalAsignarPersonal" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="False">
            <ScrollView VerticalOptions="Center" HorizontalOptions="Center" Padding="15">
                <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" MaximumWidthRequest="500" Padding="24">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Asignación de Personal" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" TextColor="#64748B" FontAttributes="Bold" FontSize="16" HeightRequest="36" WidthRequest="36" Clicked="OnCerrarModalPersonalClicked" VerticalOptions="Center"/>
                        </Grid>

                        <Label x:Name="LblPersonalRequeridoInfo" Text="Requerimiento de personal" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Asignar Cocinero" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                            <Frame BorderColor="#CBD5E1" CornerRadius="8" Padding="6" BackgroundColor="#F8FAFC" HasShadow="False" HeightRequest="42">
                                <Picker x:Name="PickerCocaine" Title="Selecciona Cocinero" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <Label x:Name="LblTituloMeseros" Text="Asignación de Meseros y Roles" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <Frame Grid.Column="0" BorderColor="#CBD5E1" CornerRadius="8" Padding="6" BackgroundColor="#F8FAFC" HasShadow="False" HeightRequest="42">
                                <Picker x:Name="PickerMesero1" Title="Mesero 1" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Frame>
                            <Frame Grid.Column="1" BorderColor="#CBD5E1" CornerRadius="8" Padding="6" BackgroundColor="#F8FAFC" HasShadow="False" HeightRequest="42">
                                <Picker x:Name="PickerRol1" Title="Rol Mesero 1" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Frame>
                        </Grid>
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <Frame Grid.Column="0" BorderColor="#CBD5E1" CornerRadius="8" Padding="6" BackgroundColor="#F8FAFC" HasShadow="False" HeightRequest="42">
                                <Picker x:Name="PickerMesero2" Title="Mesero 2" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Frame>
                            <Frame Grid.Column="1" BorderColor="#CBD5E1" CornerRadius="8" Padding="6" BackgroundColor="#F8FAFC" HasShadow="False" HeightRequest="42">
                                <Picker x:Name="PickerRol2" Title="Rol Mesero 2" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Frame>
                        </Grid>
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <Frame Grid.Column="0" BorderColor="#CBD5E1" CornerRadius="8" Padding="6" BackgroundColor="#F8FAFC" HasShadow="False" HeightRequest="42">
                                <Picker x:Name="PickerMesero3" Title="Mesero 3" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Frame>
                            <Frame Grid.Column="1" BorderColor="#CBD5E1" CornerRadius="8" Padding="6" BackgroundColor="#F8FAFC" HasShadow="False" HeightRequest="42">
                                <Picker x:Name="PickerRol3" Title="Rol Mesero 3" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Frame>
                        </Grid>
                        <VerticalStackLayout x:Name="GridMesero4" Spacing="4">
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Frame Grid.Column="0" BorderColor="#CBD5E1" CornerRadius="8" Padding="6" BackgroundColor="#F8FAFC" HasShadow="False" HeightRequest="42">
                                    <Picker x:Name="PickerMesero4" Title="Mesero 4" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                                </Frame>
                                <Frame Grid.Column="1" BorderColor="#CBD5E1" CornerRadius="8" Padding="6" BackgroundColor="#F8FAFC" HasShadow="False" HeightRequest="42">
                                    <Picker x:Name="PickerRol4" Title="Rol Mesero 4" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                                </Frame>
                            </Grid>
                        </VerticalStackLayout>

                        <Button Text="Guardar Asignación" BackgroundColor="#1E293B" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" Clicked="OnGuardarPersonalClicked" Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- ========================================== -->
        <!-- MODAL VER STAFF (Lista Sobria)             -->
        <!-- ========================================== -->
        <Grid x:Name="ModalVerStaff" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="False">
            <ScrollView VerticalOptions="Center" HorizontalOptions="Center" Padding="15">
                <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" MaximumWidthRequest="450" Padding="24">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Staff Asignado al Evento" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" TextColor="#64748B" FontAttributes="Bold" FontSize="16" HeightRequest="36" WidthRequest="36" Clicked="OnCerrarModalVerStaffClicked" VerticalOptions="Center"/>
                        </Grid>

                        <CollectionView x:Name="ColeccionStaffAsignado" HeightRequest="200">
                            <CollectionView.EmptyView>
                                <Label Text="No hay personal asignado actualmente." HorizontalOptions="Center" TextColor="#94A3B8" FontSize="13"/>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12" Margin="0,0,0,8">
                                        <Border.StrokeShape>
                                            <shapes:RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding NombreCompleto}" FontAttributes="Bold" TextColor="#1E293B" FontSize="13"/>
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Puesto}" FontAttributes="Bold" TextColor="#0F766E" FontSize="12"/>
                                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Rol}" TextColor="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

    </Grid>
</ContentPage>