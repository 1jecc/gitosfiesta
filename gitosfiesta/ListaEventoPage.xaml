<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gitosfiesta.ListaEventoPage"
             Title="Lista de Eventos"
             BackgroundColor="#E2F2F4">

    <Grid RowDefinitions="Auto, *" Padding="20">

        <!-- ========================================== -->
        <!-- VISTA 1: PANEL DE FILTROS Y LISTA GENERAL -->
        <!-- ========================================== -->
        <VerticalStackLayout x:Name="PanelLista" Grid.Row="0" Grid.RowSpan="2" Spacing="0">

            <!-- Panel de Filtros Superiores -->
            <Frame BackgroundColor="White" CornerRadius="12" HasShadow="True" Padding="15" Margin="0,0,0,15" BorderColor="#00D2C4">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Buscar y Filtrar Eventos" FontAttributes="Bold" FontSize="14" TextColor="#2D3748"/>

                    <!-- Búsqueda por Nombre -->
                    <Frame CornerRadius="8" Padding="8,2" HeightRequest="42" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#CBD5E0">
                        <Entry x:Name="TxtBuscarNombre" 
                               Placeholder="🔍 Buscar por nombre del cliente..." 
                               TextColor="#333" 
                               BackgroundColor="Transparent" 
                               TextChanged="OnFiltroCombinadoChanged"
                               VerticalOptions="Center"/>
                    </Frame>

                    <!-- Filtros desplegables y Fechas -->
                    <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="8">

                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Vigencia" FontSize="11" TextColor="#718096" FontAttributes="Bold"/>
                            <Frame CornerRadius="8" Padding="6,2" HeightRequest="42" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#CBD5E0">
                                <Picker x:Name="PickerFiltro" TextColor="#333" BackgroundColor="Transparent" SelectedIndexChanged="OnFiltroCombinadoChanged" VerticalOptions="Center">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Vigentes</x:String>
                                            <x:String>Caducados</x:String>
                                            <x:String>Todos</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Estatus" FontSize="11" TextColor="#718096" FontAttributes="Bold"/>
                            <Frame CornerRadius="8" Padding="6,2" HeightRequest="42" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#CBD5E0">
                                <Picker x:Name="PickerEstatus" TextColor="#333" BackgroundColor="Transparent" SelectedIndexChanged="OnFiltroCombinadoChanged" VerticalOptions="Center">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Todos los estatus</x:String>
                                            <x:String>Abierto y por pagar</x:String>
                                            <x:String>Liquidado / Pagado</x:String>
                                            <x:String>Cancelado</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="Desde (±15d)" FontSize="11" TextColor="#718096" FontAttributes="Bold"/>
                            <Frame CornerRadius="8" Padding="6,2" HeightRequest="42" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#CBD5E0">
                                <DatePicker x:Name="DatePickerDesde" TextColor="#333" BackgroundColor="Transparent" DateSelected="OnFiltroCombinadoChanged" VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" Spacing="2">
                            <Label Text="Hasta" FontSize="11" TextColor="#718096" FontAttributes="Bold"/>
                            <Frame CornerRadius="8" Padding="6,2" HeightRequest="42" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#CBD5E0">
                                <DatePicker x:Name="DatePickerHasta" TextColor="#333" BackgroundColor="Transparent" DateSelected="OnFiltroCombinadoChanged" VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Colección de Eventos -->
            <CollectionView x:Name="ColeccionEventos" 
                            HeightRequest="500"
                            SelectionMode="Single" 
                            SelectionChanged="OnEventoSelected">
                <CollectionView.EmptyView>
                    <Label Text="No se encontraron eventos con los filtros seleccionados." HorizontalOptions="Center" VerticalOptions="Center" TextColor="#888" FontSize="14"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" CornerRadius="12" HasShadow="True" Padding="15" Margin="0,0,0,12" BorderColor="#00D2C4">
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding nombre_cliente}" FontAttributes="Bold" FontSize="15" TextColor="#2D3748"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding fecha_evento, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#00D2C4" FontSize="13"/>
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding tipo_evento}" FontSize="13" TextColor="#718096" Margin="0,4,0,0"/>
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding estatus}" FontSize="12" TextColor="#E53E3E" FontAttributes="Bold" Margin="0,6,0,0"/>
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding precio, StringFormat='${0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#2B6CB0" VerticalOptions="End"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>


        <!-- ========================================== -->
        <!-- VISTA 2: PANEL DE DETALLE DEL EVENTO       -->
        <!-- ========================================== -->
        <ScrollView x:Name="PanelDetalle" Grid.Row="0" Grid.RowSpan="2" IsVisible="False">
            <VerticalStackLayout Spacing="16" Padding="5">

                <!-- CABECERA SUPERIOR: Botón Regresar + Botones de Acción a la misma altura -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">

                    <!-- Lado Izquierdo: Botón de Regresar -->
                    <Button Grid.Column="0"
                            Text="⬅️ Regresar a la lista" 
                            BackgroundColor="#4A5568" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="10" 
                            HeightRequest="42"
                            WidthRequest="180"
                            HorizontalOptions="Start"
                            Clicked="OnRegresarClicked"/>

                    <!-- Lado Derecho: Los 3 Botones de Acción alineados a la derecha -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="10" HorizontalOptions="End">
                        <Button Text="👥 Asignar Personal" 
                                BackgroundColor="#319795" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                FontSize="12"
                                CornerRadius="10" 
                                HeightRequest="42"
                                Clicked="OnAsignarPersonalClicked"/>

                        <Button Text="💬 Comentarios" 
                                BackgroundColor="#D69E2E" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                FontSize="12"
                                CornerRadius="10" 
                                HeightRequest="42"
                                Clicked="OnAgregarComentariosClicked"/>

                        <Button Text="💳 Realizar Pago" 
                                BackgroundColor="#38A169" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                FontSize="12"
                                CornerRadius="10" 
                                HeightRequest="42"
                                Clicked="OnRealizarPagoClicked"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Tarjeta Principal de Detalles -->
                <Frame BackgroundColor="White" BorderColor="#00D2C4" CornerRadius="16" HasShadow="True" Padding="25">
                    <VerticalStackLayout Spacing="18">

                        <!-- Encabezado -->
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Detalles del Evento" FontAttributes="Bold" FontSize="20" TextColor="#2D3748"/>
                            <BoxView HeightRequest="3" BackgroundColor="#00D2C4" WidthRequest="60" CornerRadius="2" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Fila 1: Folio y Fecha Contrato -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <Frame Grid.Column="0" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="FOLIO" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleFolio" Text="---" TextColor="#2D3748" FontAttributes="Bold" FontSize="14"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="FECHA DE CONTRATO" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleFechaContrato" Text="---" TextColor="#2D3748" FontSize="13"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Fila 2: Cliente y Teléfono -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <Frame Grid.Column="0" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="CLIENTE" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleCliente" Text="---" TextColor="#2D3748" FontAttributes="Bold" FontSize="14"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="TELÉFONO" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleTelefono" Text="---" TextColor="#2D3748" FontSize="13"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Fila 3: Tipo de Evento, Fecha y Hora -->
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                            <Frame Grid.Column="0" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="EVENTO" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleTipoEvento" Text="---" TextColor="#2D3748" FontSize="13"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="FECHA" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleFechaEvento" Text="---" TextColor="#2D3748" FontSize="13"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="2" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="HORA" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleHora" Text="---" TextColor="#2D3748" FontSize="13"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Fila 4: Personas y Estatus -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <Frame Grid.Column="0" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="NÚMERO DE PERSONAS" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetallePersonas" Text="---" TextColor="#2D3748" FontSize="13"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1" BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                                <VerticalStackLayout>
                                    <Label Text="ESTATUS" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                    <Label x:Name="LblDetalleEstatus" Text="---" TextColor="#E53E3E" FontAttributes="Bold" FontSize="13"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Menú / Paquete -->
                        <Frame BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="MENÚ / PAQUETE" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                <Label x:Name="LblDetalleMenu" Text="---" TextColor="#2D3748" FontSize="13"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Tarjeta de Costos (Finanzas) -->
                        <Frame BackgroundColor="#EDF2F7" BorderColor="#CBD5E0" CornerRadius="10" Padding="12" HasShadow="False">
                            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="PRECIO" FontAttributes="Bold" TextColor="#4A5568" FontSize="11"/>
                                    <Label x:Name="LblDetallePrecio" Text="---" TextColor="#2B6CB0" FontAttributes="Bold" FontSize="15"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="ANTICIPO" FontAttributes="Bold" TextColor="#4A5568" FontSize="11"/>
                                    <Label x:Name="LblDetalleAnticipo" Text="---" TextColor="#38A169" FontAttributes="Bold" FontSize="15"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="ABONOS" FontAttributes="Bold" TextColor="#4A5568" FontSize="11"/>
                                    <Label x:Name="LblDetalleAbonos" Text="---" TextColor="#319795" FontAttributes="Bold" FontSize="15"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3">
                                    <Label Text="SALDO" FontAttributes="Bold" TextColor="#E53E3E" FontSize="11"/>
                                    <Label x:Name="LblDetalleSaldo" Text="---" TextColor="#E53E3E" FontAttributes="Bold" FontSize="15"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                        <!-- Promoción -->
                        <Frame BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="PROMOCIÓN" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                <Label x:Name="LblDetallePromocion" Text="Ninguna" TextColor="#2D3748" FontSize="13"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Observaciones -->
                        <Frame BackgroundColor="#F8F9FA" Padding="10" CornerRadius="8" HasShadow="False">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="OBSERVACIONES" FontAttributes="Bold" TextColor="#718096" FontSize="11"/>
                                <Label x:Name="LblDetalleObservaciones" Text="Ninguna" TextColor="#2D3748" FontSize="13"/>
                            </VerticalStackLayout>
                        </Frame>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>


        <!-- ========================================== -->
        <!-- MODAL PERSONALIZADO PARA COMENTARIOS       -->
        <!-- ========================================== -->
        <Grid x:Name="ModalComentarios" 
              Grid.Row="0" 
              Grid.RowSpan="2" 
              BackgroundColor="#80000000" 
              IsVisible="False" 
              HorizontalOptions="Fill" 
              VerticalOptions="Fill">

            <Frame BackgroundColor="#E2F2F4" 
                   CornerRadius="16" 
                   WidthRequest="480" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" 
                   Padding="20" 
                   HasShadow="True">
                <VerticalStackLayout Spacing="16">

                    <!-- Título y Subtítulo -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Comentarios y Observaciones" 
                               FontAttributes="Bold" 
                               FontSize="18" 
                               TextColor="#333333"/>
                        <Label Text="Edita o añade observaciones para este evento:" 
                               FontSize="13" 
                               TextColor="#666666"/>
                    </VerticalStackLayout>

                    <!-- Editor multilínea con diseño limpio -->
                    <Frame CornerRadius="10" 
                           Padding="10" 
                           BackgroundColor="White" 
                           BorderColor="#00D2C4" 
                           HasShadow="False">
                        <Editor x:Name="TxtModalComentarios" 
                                TextColor="#333333" 
                                Placeholder="Escribe aquí las observaciones..." 
                                PlaceholderColor="#888888" 
                                BackgroundColor="Transparent" 
                                HeightRequest="140" 
                                AutoSize="Disabled"/>
                    </Frame>

                    <!-- Botones del Modal con estilo unificado -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                        <Button Grid.Column="0" 
                                Text="Guardar" 
                                BackgroundColor="#00D2C4" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="10" 
                                HeightRequest="45" 
                                Clicked="OnGuardarComentarioModalClicked"/>

                        <Button Grid.Column="1" 
                                Text="Cancelar" 
                                BackgroundColor="#718096" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="10" 
                                HeightRequest="45" 
                                Clicked="OnCancelarComentarioModalClicked"/>
                    </Grid>

                </VerticalStackLayout>
            </Frame>
        </Grid>


        <!-- ========================================== -->
        <!-- MODAL EMERGENTE: MÓDULO DE COBRANZA / ABONOS -->
        <!-- ========================================== -->
        <Grid x:Name="ModalAbonos" 
              Grid.Row="0" 
              Grid.RowSpan="2" 
              BackgroundColor="#80000000" 
              IsVisible="False" 
              HorizontalOptions="Fill" 
              VerticalOptions="Fill">

            <ScrollView VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                <Frame BackgroundColor="#E2F2F4" CornerRadius="16" WidthRequest="480" Padding="20" HasShadow="True">
                    <VerticalStackLayout Spacing="18">

                        <!-- Título y Botón Cerrar -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Módulo de Cobranza" FontSize="20" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" TextColor="#333" FontAttributes="Bold" FontSize="16" Clicked="OnCerrarModalAbonosClicked"/>
                        </Grid>

                        <!-- SECCIÓN 1: Estado de Cuenta (Cargado Automáticamente) -->
                        <Frame BackgroundColor="White" CornerRadius="12" HasShadow="False" Padding="15" BorderColor="#333">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Estado de Cuenta del Evento" FontAttributes="Bold" TextColor="#333" FontSize="15" HorizontalOptions="Center"/>
                                <BoxView HeightRequest="1" Color="#DDD" Margin="0,2"/>

                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="6">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Costo Total:" TextColor="#555" FontSize="13"/>
                                    <Label Grid.Row="0" Grid.Column="1" x:Name="LblModalCostoTotal" Text="$0.00" FontAttributes="Bold" TextColor="#333" FontSize="13"/>

                                    <Label Grid.Row="1" Grid.Column="0" Text="Anticipo Inicial:" TextColor="#555" FontSize="13"/>
                                    <Label Grid.Row="1" Grid.Column="1" x:Name="LblModalAnticipo" Text="$0.00" FontAttributes="Bold" TextColor="#333" FontSize="13"/>

                                    <Label Grid.Row="2" Grid.Column="0" Text="Abonos Acumulados:" TextColor="#555" FontSize="13"/>
                                    <Label Grid.Row="2" Grid.Column="1" x:Name="LblModalAbonosAcumulados" Text="$0.00" FontAttributes="Bold" TextColor="#333" FontSize="13"/>
                                </Grid>

                                <Frame BackgroundColor="#FFF0F5" CornerRadius="8" Padding="8" BorderColor="Transparent" Margin="0,5,0,0">
                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                        <Label Text="SALDO PENDIENTE:" FontAttributes="Bold" TextColor="#E91E63" FontSize="13" VerticalOptions="Center"/>
                                        <Label x:Name="LblModalSaldoPendiente" Text="$0.00" FontAttributes="Bold" TextColor="#E91E63" FontSize="18" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Frame>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- SECCIÓN 2: Registrar Nuevo Abono -->
                        <Frame BackgroundColor="White" CornerRadius="12" HasShadow="False" Padding="15" BorderColor="#00D2C4">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Registrar Nuevo Abono" FontAttributes="Bold" TextColor="#333" FontSize="14"/>

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Monto a Abonar ($)" FontSize="12" TextColor="#555" FontAttributes="Bold"/>
                                        <Frame CornerRadius="8" Padding="6" BackgroundColor="#F8F9FA" BorderColor="#DCDCDC">
                                            <Entry x:Name="TxtModalMontoAbono" Placeholder="0.00" Keyboard="Numeric" TextColor="#333" BackgroundColor="Transparent"/>
                                        </Frame>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Método" FontSize="12" TextColor="#555" FontAttributes="Bold"/>
                                        <Frame CornerRadius="8" Padding="6" BackgroundColor="#F8F9FA" BorderColor="#DCDCDC">
                                            <Picker x:Name="PickerModalMetodo" Title="Selecciona" TextColor="#333" BackgroundColor="Transparent">
                                                <Picker.ItemsSource>
                                                    <x:Array Type="{x:Type x:String}">
                                                        <x:String>Efectivo</x:String>
                                                        <x:String>Transferencia</x:String>
                                                        <x:String>Tarjeta</x:String>
                                                    </x:Array>
                                                </Picker.ItemsSource>
                                            </Picker>
                                        </Frame>
                                    </VerticalStackLayout>
                                </Grid>

                                <Button Text="Registrar Pago" BackgroundColor="#00D2C4" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="45" Clicked="OnRegistrarPagoModalClicked"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- SECCIÓN 3: Historial de Pagos -->
                        <Frame BackgroundColor="White" CornerRadius="12" HasShadow="False" Padding="15" BorderColor="#8E24AA">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Historial de Abonos" FontAttributes="Bold" TextColor="#333" FontSize="14" HorizontalOptions="Center"/>
                                <BoxView HeightRequest="1" Color="#DDD" Margin="0,2"/>

                                <CollectionView x:Name="ColeccionModalHistorial" HeightRequest="120">
                                    <CollectionView.EmptyView>
                                        <Label Text="Aún no hay abonos registrados." HorizontalOptions="Center" TextColor="#888" FontAttributes="Italic" FontSize="12" Margin="0,5"/>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,4">
                                                <Label Grid.Column="0" Text="{Binding FechaPago, StringFormat='{0:dd-MM-yyyy}'}" TextColor="#555" FontSize="12" VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding MetodoPago}" TextColor="#888" FontSize="11" Margin="0,0,10,0" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding Monto, StringFormat='${0:F2}'}" FontAttributes="Bold" TextColor="#00D2C4" FontSize="12" VerticalOptions="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>

                    </VerticalStackLayout>
                </Frame>
            </ScrollView>
        </Grid>

    </Grid>
</ContentPage>