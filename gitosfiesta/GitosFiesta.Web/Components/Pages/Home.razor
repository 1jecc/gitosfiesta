@page "/"
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión - GitosFiesta</PageTitle>

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg border-0 p-4" style="max-width: 420px; width: 100%; border-radius: 24px; background-color: #ffffff;">
        
        <div class="text-center mb-4">
            <!-- Aquí puedes usar tu logo -->
            <h2 class="fw-bold" style="color: #3F3B78;">🎉 GitosFiesta</h2>
            <p class="text-muted" style="font-size: 15px;">Inicia sesión para continuar</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger text-center" role="alert">
                @errorMessage
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="@IniciarSesionSupabase">
            <div class="mb-3">
                <label class="form-label fw-bold text-dark" style="font-size: 13px;">Usuario o Correo</label>
                <InputText class="form-control bg-light border-0 py-2" @bind-Value="loginModel.Usuario" placeholder="Escribe tu usuario" required style="border-radius: 12px;" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-dark" style="font-size: 13px;">Contraseña</label>
                <InputText type="password" class="form-control bg-light border-0 py-2" @bind-Value="loginModel.Password" placeholder="Escribe tu contraseña" required style="border-radius: 12px;" />
            </div>

            <button type="submit" class="btn w-100 py-3 fw-bold text-white mt-3" style="background-color: #00D2C4; border-radius: 12px;" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Validando...</span>
                }
                else
                {
                    <span>Iniciar Sesión</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
