@page "/"
@inject Supabase.Client SupabaseClient
@inject NavigationManager Navigation

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg p-4" style="max-width: 420px; width: 100%; border-radius: 24px;">
        <h3 class="text-center mb-3" style="color: #3F3B78;">🎉 GitosFiesta</h3>
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="@IniciarSesion">
            <div class="mb-3">
                <label class="fw-bold">Usuario o Correo</label>
                <InputText class="form-control" @bind-Value="loginModel.Usuario" required />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Contraseña</label>
                <InputText type="password" class="form-control" @bind-Value="loginModel.Password" required />
            </div>
            <button type="submit" class="btn w-100 text-white fw-bold py-2" style="background-color: #00D2C4; border-radius: 12px;">
                Iniciar Sesión
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private string errorMessage = string.Empty;

    private async Task IniciarSesion()
    {
        try
        {
            // Forzamos explícitamente el nombre de la tabla de Supabase para evitar errores de ruta en WebAssembly
            var response = await SupabaseClient
                .From<Usuario>()
                .Table("gitosfiesta_usuarios")
                .Get();

            var userFound = response.Models.FirstOrDefault(x => 
                x.NombreUsuario == loginModel.Usuario && 
                x.Password == loginModel.Password && 
                x.Enable);

            if (userFound != null)
            {
                // Guardamos la sesión globalmente igual que en MAUI
                SessionContext.UsuarioId = (int)userFound.Id;
                SessionContext.NombreCompleto = $"{userFound.Nombre} {userFound.ApellidoPaterno}";
                SessionContext.Rol = userFound.AccessType;

                // Redirigimos al panel o módulo principal
                Navigation.NavigateTo("/nuevo-evento");
            }
            else
            {
                errorMessage = "Usuario o contraseña incorrectos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión: {ex.Message}";
        }
    }

    public class LoginModel
    {
        public string Usuario { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
