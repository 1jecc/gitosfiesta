<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gitosfiesta.AbonosPage"
             Title="Registro de Abonos"
             BackgroundColor="#E2F2F4">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" HorizontalOptions="Center" MaximumWidthRequest="500">

            <Label Text="Módulo de Cobranza" FontSize="22" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>

            <!-- SECCIÓN 1: Buscar Evento -->
            <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20" BorderColor="#00D2C4">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1. Selecciona el Evento/Contrato" FontAttributes="Bold" TextColor="#333"/>
                    <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#DCDCDC">
                        <Picker x:Name="PickerEventos" 
                                Title="Selecciona un cliente con saldo pendiente..." 
                                TextColor="#333" 
                                ItemDisplayBinding="{Binding nombre_cliente}"
                                SelectedIndexChanged="OnEventoSeleccionado"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- SECCIÓN 2: Estado de Cuenta -->
            <Frame x:Name="PanelEstadoCuenta" IsVisible="False" BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20" BorderColor="#333">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Estado de Cuenta" FontAttributes="Bold" TextColor="#333" FontSize="16" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="1" Color="#DDD" Margin="0,5"/>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Costo Total del Evento:" TextColor="#555"/>
                        <Label Grid.Row="0" Grid.Column="1" x:Name="LblCostoTotal" Text="$0.00" FontAttributes="Bold" TextColor="#333"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Anticipo Inicial:" TextColor="#555"/>
                        <Label Grid.Row="1" Grid.Column="1" x:Name="LblAnticipo" Text="$0.00" FontAttributes="Bold" TextColor="#333"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Abonos Acumulados:" TextColor="#555"/>
                        <Label Grid.Row="2" Grid.Column="1" x:Name="LblAbonosAcumulados" Text="$0.00" FontAttributes="Bold" TextColor="#333"/>
                    </Grid>

                    <Frame BackgroundColor="#FFF0F5" CornerRadius="8" Padding="10" BorderColor="Transparent" Margin="0,10,0,0">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label Text="SALDO PENDIENTE:" FontAttributes="Bold" TextColor="#E91E63" VerticalOptions="Center"/>
                            <Label x:Name="LblSaldoPendiente" Text="$0.00" FontAttributes="Bold" TextColor="#E91E63" FontSize="20" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- SECCIÓN 3: Registrar Nuevo Pago -->
            <Frame x:Name="PanelRegistrarPago" IsVisible="False" BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20" BorderColor="#00D2C4">
                <VerticalStackLayout Spacing="15">
                    <Label Text="2. Registrar Nuevo Abono" FontAttributes="Bold" TextColor="#333"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Monto a Abonar ($)" FontSize="13" TextColor="#555" FontAttributes="Bold"/>
                            <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" BorderColor="#DCDCDC">
                                <Entry x:Name="TxtMontoAbono" Placeholder="0.00" Keyboard="Numeric" TextColor="#333"/>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Método" FontSize="13" TextColor="#555" FontAttributes="Bold"/>
                            <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" BorderColor="#DCDCDC">
                                <Picker x:Name="PickerMetodo" Title="Selecciona" TextColor="#333">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Efectivo</x:String>
                                            <x:String>Transferencia</x:String>
                                            <x:String>Tarjeta</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="Registrar Pago" BackgroundColor="#00D2C4" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnRegistrarPagoClicked"/>
                </VerticalStackLayout>
            </Frame>

            <!-- SECCIÓN 4: Historial de Pagos -->
            <Frame x:Name="PanelHistorialPagos" IsVisible="False" BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20" BorderColor="#8E24AA" Margin="0,0,0,20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Historial de Pagos" FontAttributes="Bold" TextColor="#333" FontSize="16" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="1" Color="#DDD" Margin="0,5"/>

                    <CollectionView x:Name="ColeccionHistorial">
                        <CollectionView.EmptyView>
                            <Label Text="Aún no hay abonos registrados para este evento." HorizontalOptions="Center" TextColor="#888" FontAttributes="Italic" Margin="0,10,0,0"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,8">
                                    <!-- Fecha -->
                                    <Label Grid.Column="0" Text="{Binding FechaPago, StringFormat='{0:dd-MM-yyyy}'}" TextColor="#555" VerticalOptions="Center"/>
                                    <!-- Método -->
                                    <Label Grid.Column="1" Text="{Binding MetodoPago}" TextColor="#888" FontSize="12" Margin="0,0,15,0" VerticalOptions="Center"/>
                                    <!-- Monto -->
                                    <Label Grid.Column="2" Text="{Binding Monto, StringFormat='${0:F2}'}" FontAttributes="Bold" TextColor="#00D2C4" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>