<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="gitosfiesta.UsuariosPage"
             Title="Gestión de Usuarios"
             BackgroundColor="#F1F5F9">

    <ScrollView Padding="24">
        <!-- Grid principal expansible en dos columnas -->
        <Grid ColumnDefinitions="*" RowDefinitions="Auto, Auto" RowSpacing="20" HorizontalOptions="Fill">

            <!-- ========================================== -->
            <!-- PANEL IZQUIERDO: Lista de Usuarios Registrados -->
            <!-- ========================================== -->
            <Border Grid.Row="0" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" Padding="20" VerticalOptions="Start">
                <Border.StrokeShape>
                    <shapes:RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">
                    <Label Text="Usuarios Registrados" FontSize="16" FontAttributes="Bold" TextColor="#1E293B"/>
                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,0,0,4"/>

                    <CollectionView x:Name="ColeccionUsuariosRegistrados" HeightRequest="560">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6" Padding="20">
                                <Label Text="No hay usuarios registrados." FontSize="13" TextColor="#64748B" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="14" Margin="0,0,0,10">
                                    <Border.StrokeShape>
                                        <shapes:RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding NombreCompletoFormateado}" FontAttributes="Bold" TextColor="#1E293B" FontSize="15"/>

                                        <Grid ColumnDefinitions="*, Auto">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                                <Label Text="Usuario:" FontSize="12" TextColor="#64748B"/>
                                                <Label Text="{Binding NombreUsuario}" FontSize="12" FontAttributes="Bold" TextColor="#0F766E"/>
                                            </HorizontalStackLayout>

                                            <Frame Grid.Column="1" BackgroundColor="#E2E8F0" Padding="8,3" HasShadow="False" CornerRadius="6" BorderColor="Transparent" VerticalOptions="Center">
                                                <Label Text="{Binding AccessType}" FontSize="11" TextColor="#334155" FontAttributes="Bold"/>
                                            </Frame>
                                        </Grid>

                                        <!-- Botones de Acción Sobrios (Tonos neutrales y corporativos) -->
                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8" Margin="0,4,0,0">
                                            <Button Grid.Column="0"
                                                    Text="Restablecer" 
                                                    BackgroundColor="#475569" 
                                                    TextColor="White" 
                                                    FontSize="12" 
                                                    FontAttributes="Bold" 
                                                    CornerRadius="6" 
                                                    HeightRequest="36"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnResetearPasswordClicked"/>

                                            <Button Grid.Column="1"
                                                    Text="Eliminar" 
                                                    BackgroundColor="#94A3B8" 
                                                    TextColor="White" 
                                                    FontSize="12" 
                                                    FontAttributes="Bold" 
                                                    CornerRadius="6" 
                                                    HeightRequest="36"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnEliminarUsuarioDirectoClicked"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================== -->
            <!-- PANEL DERECHO: Formulario de Creación      -->
            <!-- ========================================== -->
            <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Start">

                <Border x:Name="PanelCrearUsuario" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" Padding="28">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Crear Nuevo Usuario" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                            <Label Text="Registra un nuevo perfil administrativo o de staff para el sistema." FontSize="13" TextColor="#64748B" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="12">
                            <Frame BorderColor="#CBD5E1" BackgroundColor="#F8FAFC" CornerRadius="8" Padding="8,2" HasShadow="False" HeightRequest="46">
                                <Entry x:Name="TxtNuevoNombre" Placeholder="Nombre(s)" TextColor="#1E293B" BackgroundColor="Transparent" TextChanged="OnNombreOApellidoChanged" VerticalOptions="Center"/>
                            </Frame>

                            <Frame BorderColor="#CBD5E1" BackgroundColor="#F8FAFC" CornerRadius="8" Padding="8,2" HasShadow="False" HeightRequest="46">
                                <Entry x:Name="TxtNuevoApellido" Placeholder="Apellido Paterno" TextColor="#1E293B" BackgroundColor="Transparent" TextChanged="OnNombreOApellidoChanged" VerticalOptions="Center"/>
                            </Frame>

                            <Frame BorderColor="#E2E8F0" BackgroundColor="#F1F5F9" CornerRadius="8" Padding="8,2" HasShadow="False" HeightRequest="46">
                                <Entry x:Name="TxtNuevoUsuario" Placeholder="Usuario generado automático" TextColor="#475569" BackgroundColor="Transparent" IsReadOnly="True" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Frame>

                            <Frame BorderColor="#CBD5E1" BackgroundColor="#F8FAFC" CornerRadius="8" Padding="8,2" HasShadow="False" HeightRequest="46">
                                <Entry x:Name="TxtNuevaPassword" Placeholder="Contraseña inicial" IsPassword="True" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Frame>

                            <Frame BorderColor="#CBD5E1" BackgroundColor="#F8FAFC" CornerRadius="8" Padding="8,2" HasShadow="False" HeightRequest="46">
                                <Picker x:Name="PickerRol" Title="Selecciona el Rol" TextColor="#1E293B" BackgroundColor="Transparent" VerticalOptions="Center">
                                    <Picker.Items>
                                        <x:String>ADMINISTRADOR</x:String>
                                        <x:String>STAFF</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Botón principal en tono sobrio (Azul marino / Pizarra oscuro) -->
                        <Button Text="Guardar Usuario" 
                                BackgroundColor="#1E293B" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                FontSize="14"
                                CornerRadius="8" 
                                HeightRequest="46" 
                                Clicked="OnCrearUsuarioClicked" 
                                Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="LblAccesoDenegado" Text="No tienes permisos de Administrador para ver esta sección." TextColor="#B91C1C" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="False" />

            </VerticalStackLayout>

        </Grid>
    </ScrollView>
</ContentPage>