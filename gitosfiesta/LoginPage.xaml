<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="gitosfiesta.LoginPage"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <Grid HorizontalOptions="Fill" Padding="16,24">

            <!-- Tarjeta Principal Amplia y Estilizada -->
            <Border BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    MaximumWidthRequest="460"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    Padding="40,35">
                <Border.StrokeShape>
                    <shapes:RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="4">

                    <!-- Logo corporativo con un tamaño proporcional y legible -->
                    <Image Source="imagen2.png" 
                           HeightRequest="170" 
                           Aspect="AspectFit" 
                           HorizontalOptions="Center"
                           Margin="0,0,0,4"/>

                    <!-- Título y subtítulo -->
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                        <Label Text="Acceso al Sistema" 
                               FontSize="22" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center" 
                               TextColor="#1E293B"/>
                        <Label Text="Ingrese sus credenciales para continuar" 
                               FontSize="13" 
                               HorizontalOptions="Center" 
                               TextColor="#64748B"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,2"/>

                    <!-- Campo de Usuario -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
                        <Label Text="Usuario o Correo" FontSize="13" TextColor="#475569" FontAttributes="Bold"/>
                        <Border Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="#F8FAFC" HeightRequest="50" Padding="14,0">
                            <Border.StrokeShape>
                                <shapes:RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry x:Name="TxtUsuario" 
                                   Placeholder="Escribe tu usuario" 
                                   TextColor="#1E293B" 
                                   PlaceholderColor="#94A3B8"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   ReturnType="Next"
                                   Completed="OnUsuarioCompleted"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo de Contraseña -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
                        <Label Text="Contraseña" FontSize="13" TextColor="#475569" FontAttributes="Bold"/>
                        <Border Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="#F8FAFC" HeightRequest="50" Padding="14,0">
                            <Border.StrokeShape>
                                <shapes:RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry x:Name="TxtPassword" 
                                   Placeholder="Escribe tu contraseña" 
                                   IsPassword="True" 
                                   TextColor="#1E293B" 
                                   PlaceholderColor="#94A3B8"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   ReturnType="Done"
                                   Completed="OnPasswordCompleted"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botón de Inicio de Sesión -->
                    <Button Text="Iniciar Sesión" 
                            BackgroundColor="#1E293B" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="16"
                            CornerRadius="8" 
                            HeightRequest="50"
                            Margin="0,6,0,0"
                            Clicked="OnLoginClicked"/>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>