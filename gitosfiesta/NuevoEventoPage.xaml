<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gitosfiesta.NuevoEventoPage"
             Title="Nuevo Evento"
             BackgroundColor="#E2F2F4">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25">


            <Label Text="Crear Nuevo Evento" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="#333333" 
                   HorizontalOptions="Center" 
                   Margin="0,10,0,10"/>

            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   HasShadow="True"
                   Padding="25"
                   BorderColor="#00D2C4">

                <VerticalStackLayout Spacing="16">

                    <!-- Nombre del Cliente -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre del Cliente" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                        <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#DCDCDC">
                            <Entry x:Name="TxtNombreCliente" Placeholder="Ej. Carlos Pérez" TextColor="#333" BackgroundColor="Transparent"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Teléfono -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Teléfono / Celular" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                        <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#DCDCDC">
                            <Entry x:Name="TxtTelefono" Placeholder="Teléfono (10 dígitos)" TextColor="#333" Keyboard="Telephone"  MaxLength="10" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Tipo de Evento -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tipo de Evento" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                        <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#DCDCDC">
                            <Entry x:Name="TxtTipoEvento" Placeholder="Ej. Cumpleaños, XV Años..." TextColor="#333" BackgroundColor="Transparent"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- 1. FECHA DEL EVENTO (Paso Inicial) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="1. Fecha del Evento" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                        <DatePicker x:Name="DatePickerFecha" TextColor="#333" BackgroundColor="#F8F9FA" DateSelected="OnFechaSelected"/>
                    </VerticalStackLayout>

                    <!-- 2. HORARIO (Se habilita al elegir fecha) -->
                    <!-- 2. HORARIO (Dinámico: Picker para Fines de Semana, TimePicker para Entre Semana) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="2. Horario del Evento" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                        <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#DCDCDC">
                            <VerticalStackLayout>
                                <!-- Picker para Sábados y Domingos (Bloques fijos) -->
                                <Picker x:Name="PickerHorario" 
                                        Title="Selecciona bloque fijo" 
                                        TextColor="#333" 
                                        IsEnabled="False" 
                                        IsVisible="True"
                                        SelectedIndexChanged="OnHorarioSelectedIndexChanged"/>

                                <!-- TimePicker para Lunes a Viernes (Hora de inicio personalizada) -->
                                <!-- TimePicker para Lunes a Viernes (Sin hora predeterminada) -->
                                <TimePicker x:Name="TimePickerEntreSemana" 
                                        TextColor="#333" 
                                        IsEnabled="False" 
                                        IsVisible="False"
                                        TimeSelected="OnTimePickerTimeSelected"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- 3. PAQUETE (Se habilita al elegir horario) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="3. Paquete Gitos Fiesta" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                        <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#DCDCDC">
                            <Picker x:Name="PickerPaquete" Title="Selecciona un paquete" TextColor="#333" IsEnabled="False" SelectedIndexChanged="OnPaqueteSelectedIndexChanged"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Número de Personas (Automático según paquete) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Número de Personas (Automático)" FontSize="13" TextColor="#555" FontAttributes="Bold"/>
                        <Frame CornerRadius="10" Padding="8" BackgroundColor="#EFEFEF" HasShadow="False" BorderColor="#DCDCDC">
                            <Entry x:Name="TxtNumeroPersonas" IsReadOnly="True" TextColor="#444" BackgroundColor="Transparent"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- 4. PLATILLO PRINCIPAL (Se habilita al elegir paquete) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="4. Platillo Principal / Menú" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                        <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#DCDCDC">
                            <Picker x:Name="PickerPlatillo" Title="Selecciona el platillo" TextColor="#333" IsEnabled="False"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Precios, Anticipo y Saldo -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Precio Total ($)" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                            <Frame CornerRadius="10" Padding="8" BackgroundColor="#EFEFEF" HasShadow="False" BorderColor="#DCDCDC">
                                <Entry x:Name="TxtPrecio" IsReadOnly="True" TextColor="#444" BackgroundColor="Transparent"/>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Anticipo ($)" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                            <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#DCDCDC">
                                <Entry x:Name="TxtAnticipo" Text="1000" Keyboard="Numeric" TextColor="#333" BackgroundColor="Transparent" TextChanged="OnPrecioAnticipoChanged"/>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Saldo Pendiente:" FontSize="14" FontAttributes="Bold" TextColor="#555"/>
                        <Label x:Name="LblSaldo" Text="$0.00" FontSize="14" FontAttributes="Bold" TextColor="#E91E63"/>
                    </HorizontalStackLayout>

                    <!-- Promoción o Notas Adicionales -->
                    <!-- Promoción (Condicional: Lunes a Viernes y >= 60 personas) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Promoción Aplicable" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                        <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#DCDCDC">
                            <Picker x:Name="PickerPromocion" Title="Selecciona promoción (si aplica)" TextColor="#333" IsEnabled="False" SelectedIndexChanged="OnPromocionSelectedIndexChanged"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- 8. EXTRAS DISPONIBLES -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Extras Disponibles (Selecciona uno o varios):" FontAttributes="Bold" TextColor="#333"/>

                        <Frame BorderColor="#00D2C4" CornerRadius="8" BackgroundColor="#F8F9FA" Padding="10" MaximumHeightRequest="160">
                            <ScrollView>
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <CheckBox x:Name="ChkShowAnimador" Color="#00D2C4" CheckedChanged="OnExtraCheckedChanged" VerticalOptions="Center"/>
                                        <Label Text="Show (1 animador y 1 botarga)" TextColor="Black" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <CheckBox x:Name="ChkDecoracionDeluxe" Color="#00D2C4" CheckedChanged="OnExtraCheckedChanged" VerticalOptions="Center"/>
                                        <Label Text="Decoración Deluxe" TextColor="Black" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <CheckBox x:Name="ChkBotargaExtra" Color="#00D2C4" CheckedChanged="OnExtraCheckedChanged" VerticalOptions="Center"/>
                                        <Label Text="Botarga extra" TextColor="Black" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <CheckBox x:Name="ChkShowPayaso" Color="#00D2C4" CheckedChanged="OnExtraCheckedChanged" VerticalOptions="Center"/>
                                        <Label Text="Show de payaso" TextColor="Black" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <CheckBox x:Name="ChkHoraExtra" Color="#00D2C4" CheckedChanged="OnExtraCheckedChanged" VerticalOptions="Center"/>
                                        <Label Text="Hora extra" TextColor="Black" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <CheckBox x:Name="ChkRentaHoraExtra" Color="#00D2C4" CheckedChanged="OnExtraCheckedChanged" VerticalOptions="Center"/>
                                        <Label Text="Renta de Hora Extra (Previa o Posterior)" TextColor="Black" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </ScrollView>
                        </Frame>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Observaciones / Notas para Staff" FontSize="13" TextColor="#333333" FontAttributes="Bold"/>
                        <Frame CornerRadius="10" Padding="8" BackgroundColor="#F8F9FA" HasShadow="False" BorderColor="#DCDCDC">
                            <Editor x:Name="TxtObservaciones" Placeholder="Detalles para refrigerador..." TextColor="#333" HeightRequest="70" BackgroundColor="Transparent"/>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <Button Text="📄 Ver Términos y Condiciones del Salón" 
                            BackgroundColor="#607D8B" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="14"
                            CornerRadius="10" 
                            HeightRequest="45"
                            Margin="0,5,0,5"
                            Clicked="OnVerTerminosClicked"/>

                    <!-- Botón Guardar -->
                    <Button x:Name="BtnAccionEvento" Text="Guardar y Registrar Evento" 
                                BackgroundColor="#00D2C4" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                FontSize="16"
                                CornerRadius="12" 
                                HeightRequest="50"
                                Margin="0,10,0,0"
                                Clicked="OnGuardarEventoClicked"/>


                </VerticalStackLayout>
            </Frame>
            

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>