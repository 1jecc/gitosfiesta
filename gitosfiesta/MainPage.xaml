<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gitosfiesta.MainPage"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False"
             Title="Inicio">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="24" Padding="32">

                <!-- ENCABEZADO DE BIENVENIDA -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="LblBienvenida" Text="¡Bienvenido!" FontSize="26" FontAttributes="Bold" TextColor="#394957"/>
                        <Label Text="Gitos Fiesta - Panel general de control y seguimiento de eventos" FontSize="13" TextColor="#8FA7B8"/>
                    </VerticalStackLayout>

                    <!-- Sección derecha con Fecha actual y Botón de perfil -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                        <Frame BackgroundColor="#F8FAFC" CornerRadius="12" Padding="12,8" HasShadow="False" BorderColor="#E2E8F0" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="📅" FontSize="14" VerticalOptions="Center"/>
                                <Label x:Name="LblFechaActual" Text="---" FontSize="12" FontAttributes="Bold" TextColor="#394957" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Frame>
                        <Frame BackgroundColor="#F3F5F6" CornerRadius="22" WidthRequest="44" HeightRequest="44" Padding="0" HasShadow="False" BorderColor="#E2E8F0" VerticalOptions="Center">
                            <Label Text="👤" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                    </HorizontalStackLayout>
                </Grid>

                <!-- 1. FILA SUPERIOR DE MÉTRICAS -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="16">

                    <!-- 1. Eventos del mes -->
                    <Frame Grid.Column="0" BackgroundColor="#DCE8F0" CornerRadius="16" HasShadow="False" Padding="16" BorderColor="Transparent">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Frame BackgroundColor="#FFFFFF" CornerRadius="12" WidthRequest="40" HeightRequest="40" Padding="0" HasShadow="False" BorderColor="Transparent">
                                <Label Text="📅" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="LblTotalMes" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#394957"/>
                                <Label Text="Eventos del mes" FontSize="11" TextColor="#5A6E7F" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>

                    <!-- 2. Finalizados -->
                    <Frame Grid.Column="1" BackgroundColor="#F5F2DF" CornerRadius="16" HasShadow="False" Padding="16" BorderColor="Transparent">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Frame BackgroundColor="#FFFFFF" CornerRadius="12" WidthRequest="40" HeightRequest="40" Padding="0" HasShadow="False" BorderColor="Transparent">
                                <Label Text="✔️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="LblFinalizados" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#394957"/>
                                <Label Text="Finalizados" FontSize="11" TextColor="#7A755E" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>

                    <!-- 3. Liquidados -->
                    <Frame Grid.Column="2" BackgroundColor="#F0DCE2" CornerRadius="16" HasShadow="False" Padding="16" BorderColor="Transparent">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Frame BackgroundColor="#FFFFFF" CornerRadius="12" WidthRequest="40" HeightRequest="40" Padding="0" HasShadow="False" BorderColor="Transparent">
                                <Label Text="💰" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="LblLiquidados" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#4E705D"/>
                                <Label Text="Liquidados" FontSize="11" TextColor="#7F5A63" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>

                    <!-- 4. Pendientes -->
                    <Frame Grid.Column="3" BackgroundColor="#EAE4DC" CornerRadius="16" HasShadow="False" Padding="16" BorderColor="Transparent">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Frame BackgroundColor="#FFFFFF" CornerRadius="12" WidthRequest="40" HeightRequest="40" Padding="0" HasShadow="False" BorderColor="Transparent">
                                <Label Text="⏰" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="LblPendientes" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#9E4E4E"/>
                                <Label Text="Pendientes" FontSize="11" TextColor="#6E6760" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>

                </Grid>

                <!-- 2. SECCIÓN INFERIOR: CONTENIDO PRINCIPAL EN 2 COLUMNAS -->
                <Grid x:Name="GridDashboard" ColumnDefinitions="*, *" ColumnSpacing="24">

                    <!-- Columna Izquierda: Alertas de Pagos -->
                    <VerticalStackLayout x:Name="PanelAlertasPagos" Grid.Column="0" Spacing="16">
                        <Frame BackgroundColor="#FFFFFF" CornerRadius="16" HasShadow="False" Padding="20" BorderColor="#E2E8F0">
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="*, Auto">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="🔔" FontSize="15" VerticalOptions="Center"/>
                                        <Label Text="Alertas de pagos próximos" FontSize="15" FontAttributes="Bold" TextColor="#394957" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="1" Text="Ver todos →" FontSize="12" TextColor="#8FA7B8" FontAttributes="Bold" VerticalOptions="Center"/>
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="#F3F5F6"/>

                                <CollectionView x:Name="ColeccionAlertas" HeightRequest="260" SelectionMode="Single" SelectionChanged="OnAlertaSelected">
                                    <CollectionView.EmptyView>
                                        <Label Text="No hay alertas pendientes de pago en este momento." FontSize="12" TextColor="#8FA7B8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame BackgroundColor="#F0DCE2" CornerRadius="12" Padding="14,12" Margin="0,0,0,8" HasShadow="False" BorderColor="#E4CBD3">
                                                <VerticalStackLayout Spacing="6">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <Label Text="{Binding Cliente}" FontAttributes="Bold" TextColor="#394957" FontSize="13"/>
                                                        <Frame Grid.Column="1" BackgroundColor="#FFFFFF" CornerRadius="10" Padding="10,4" HasShadow="False" BorderColor="Transparent">
                                                            <Label Text="Pendiente" TextColor="#9E4E4E" FontSize="11" FontAttributes="Bold"/>
                                                        </Frame>
                                                    </Grid>

                                                    <HorizontalStackLayout Spacing="8">
                                                        <Label Text="⏳" FontSize="11" VerticalOptions="Center"/>
                                                        <Label Text="{Binding MensajeAlerta}" TextColor="#9E4E4E" FontSize="11" VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Columna Derecha: Próximos Eventos -->
                    <VerticalStackLayout Grid.Column="1" Spacing="16">
                        <Frame BackgroundColor="#FFFFFF" CornerRadius="16" HasShadow="False" Padding="20" BorderColor="#E2E8F0">
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="*, Auto">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="📅" FontSize="15" VerticalOptions="Center"/>
                                        <Label x:Name="LblTituloProximos" Text="Próximos Eventos" FontSize="15" FontAttributes="Bold" TextColor="#394957" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="#F3F5F6"/>

                                <CollectionView x:Name="ColeccionProximos" HeightRequest="260" SelectionMode="Single" SelectionChanged="OnProximoEventoSelected">
                                    <CollectionView.EmptyView>
                                        <Label Text="No hay próximos eventos registrados." FontSize="12" TextColor="#8FA7B8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Padding="4,8" Spacing="6">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <Label Text="{Binding nombre_cliente}" FontAttributes="Bold" TextColor="#394957" FontSize="13"/>
                                                    <Frame Grid.Column="1" BackgroundColor="#DCE8F0" CornerRadius="10" Padding="10,4" HasShadow="False" BorderColor="Transparent">
                                                        <Label Text="{Binding estatus}" TextColor="#394957" FontSize="11" FontAttributes="Bold"/>
                                                    </Frame>
                                                </Grid>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="📅" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding FechaFormateada}" TextColor="#8FA7B8" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="|" TextColor="#E2E8F0" FontSize="11"/>
                                                    <Label Text="👥" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding tipo_evento}" TextColor="#8FA7B8" FontSize="11" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                                <BoxView HeightRequest="1" Color="#F3F5F6" Margin="0,6,0,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- MODAL FLOTANTE DE DETALLES Y ACTIVIDADES PARA EL STAFF -->
        <Grid x:Name="ModalStaffEvento" BackgroundColor="#80000000" IsVisible="False" Padding="20">
            <Frame BackgroundColor="White" CornerRadius="16" HasShadow="True" Padding="24" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="500" MaximumHeightRequest="600">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Detalle de Asignación y Actividades" FontAttributes="Bold" FontSize="18" TextColor="#1B1464" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" TextColor="#64748B" FontSize="18" FontAttributes="Bold" HeightRequest="40" WidthRequest="40" Clicked="OnCerrarModalStaffClicked"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E2E8F0"/>

                    <ScrollView HeightRequest="400">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Cliente:" FontAttributes="Bold" TextColor="#64748B" FontSize="12"/>
                            <Label x:Name="LblModalStaffCliente" Text="---" TextColor="#1E293B" FontSize="15" FontAttributes="Bold"/>

                            <Label Text="Fecha y Hora:" FontAttributes="Bold" TextColor="#64748B" FontSize="12"/>
                            <Label x:Name="LblModalStaffFecha" Text="---" TextColor="#1E293B" FontSize="14"/>

                            <!-- Tipo de evento y cantidad de personas -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Tipo de Evento:" FontAttributes="Bold" TextColor="#64748B" FontSize="12"/>
                                    <Label x:Name="LblModalStaffTipoEvento" Text="---" TextColor="#1E293B" FontSize="14" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Invitados:" FontAttributes="Bold" TextColor="#64748B" FontSize="12"/>
                                    <Label x:Name="LblModalStaffPersonas" Text="---" TextColor="#1E293B" FontSize="14" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Puesto:" FontAttributes="Bold" TextColor="#64748B" FontSize="12"/>
                                    <Label x:Name="LblModalStaffPuesto" Text="---" TextColor="#0F766E" FontSize="14" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Rol Asignado:" FontAttributes="Bold" TextColor="#64748B" FontSize="12"/>
                                    <Label x:Name="LblModalStaffRol" Text="---" TextColor="#E91E63" FontSize="14" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,4"/>

                            <Label Text="📋 Actividades y Descripción del Rol:" FontAttributes="Bold" TextColor="#1B1464" FontSize="13"/>
                            <Label x:Name="LblModalStaffDescripcionRol" Text="Cargando actividades..." TextColor="#334155" FontSize="12" LineBreakMode="WordWrap"/>

                            <Label Text="Observaciones del Evento:" FontAttributes="Bold" TextColor="#64748B" FontSize="12" Margin="0,4,0,0"/>
                            <Label x:Name="LblModalStaffObservaciones" Text="Ninguna" TextColor="#1E293B" FontSize="13"/>
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>