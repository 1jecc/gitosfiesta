<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gitosfiesta.MainPage"
             BackgroundColor="#E9F7F8">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,40,30,30"
            Spacing="25"
            HorizontalOptions="Center"
            MaximumWidthRequest="500">

            <!-- Logotipo de Gitos Fiesta -->
            <Image
                Source="logo_login.jpeg"
                HeightRequest="200"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <!-- Título Principal -->
            <Label
                Text="¡Bienvenido a Gitos Fiesta!"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#1A3C40"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <!-- Descripción de bienvenida -->
            <Label
                Text="Sistema de gestión y control de eventos. Utiliza el menú lateral para navegar entre las diferentes secciones."
                FontSize="15"
                TextColor="#7A8B8E"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineHeight="1.2" />

            <!-- Tarjeta o botón de acción rápida -->
            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   HasShadow="True"
                   Padding="20"
                   BorderColor="#B2F0EC"
                   HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Panel Principal"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1A3C40" />
                    <Label Text="Tu sesión está activa y lista para operar las herramientas del sistema."
                           FontSize="14"
                           TextColor="#666666" />

                    <Button
                        x:Name="CounterBtn"
                        Text="¡Acción Rápida!" 
                        BackgroundColor="#00D2C4"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="48"
                        Clicked="OnCounterClicked"
                        HorizontalOptions="Fill" 
                        Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>