<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gitosfiesta.MainPage"
             Title="Inicio"
             BackgroundColor="#FFFFFF">
    <ScrollView>
        <VerticalStackLayout Padding="24,28" Spacing="20">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="LblBienvenida" Text="¡Bienvenido!" FontSize="28" FontAttributes="Bold" TextColor="#394957" />
                    <Label Text="Gitos Fiesta - Panel general de control y seguimiento de eventos" FontSize="14" TextColor="#8FA7B8" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Row="1" Spacing="10">
                    <Frame BackgroundColor="#F8FAFC" BorderColor="#E2E8F0" CornerRadius="12" Padding="12,8" HasShadow="False">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="📅" FontSize="14" />
                            <Label x:Name="LblFechaActual" Text="---" FontSize="13" FontAttributes="Bold" TextColor="#394957" />
                        </HorizontalStackLayout>
                    </Frame>
                    <Frame BackgroundColor="#F3F5F6" BorderColor="#E2E8F0" CornerRadius="24" WidthRequest="48" HeightRequest="48" Padding="0" HasShadow="False">
                        <Label Text="👤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                </HorizontalStackLayout>
            </Grid>

            <Grid x:Name="GridMetricas" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#DCE8F0" CornerRadius="16" Padding="14" HasShadow="False" BorderColor="Transparent">
                    <VerticalStackLayout Spacing="4"><Label Text="📅" FontSize="22" /><Label x:Name="LblTotalMes" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#394957" /><Label Text="Eventos del mes" FontSize="12" TextColor="#5A6E7F" /></VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#F5F2DF" CornerRadius="16" Padding="14" HasShadow="False" BorderColor="Transparent">
                    <VerticalStackLayout Spacing="4"><Label Text="✔️" FontSize="22" /><Label x:Name="LblFinalizados" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#394957" /><Label Text="Finalizados" FontSize="12" TextColor="#7A755E" /></VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#F0DCE2" CornerRadius="16" Padding="14" HasShadow="False" BorderColor="Transparent">
                    <VerticalStackLayout Spacing="4"><Label Text="💰" FontSize="22" /><Label x:Name="LblLiquidados" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#4E705D" /><Label Text="Liquidados" FontSize="12" TextColor="#7F5A63" /></VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#EAE4DC" CornerRadius="16" Padding="14" HasShadow="False" BorderColor="Transparent">
                    <VerticalStackLayout Spacing="4"><Label Text="⏰" FontSize="22" /><Label x:Name="LblPendientes" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#9E4E4E" /><Label Text="Pendientes" FontSize="12" TextColor="#6E6760" /></VerticalStackLayout>
                </Frame>
            </Grid>

            <Grid x:Name="GridDashboard" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="16">
                <Frame Grid.Row="0" BackgroundColor="White" BorderColor="#DCE4EC" CornerRadius="16" Padding="16" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="LblTituloProximos" Text="Próximos Eventos" FontSize="18" FontAttributes="Bold" TextColor="#394957" />
                        <CollectionView x:Name="ColeccionProximos" HeightRequest="420" SelectionMode="Single" SelectionChanged="OnEventoDashboardSelected">
                            <CollectionView.EmptyView><Label Text="No hay próximos eventos." TextColor="#8FA7B8" HorizontalOptions="Center" VerticalOptions="Center" /></CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="#F4E1E5" BorderColor="#EBCBD2" CornerRadius="14" Padding="14" Margin="0,0,0,10" HasShadow="False">
                                        <Frame.GestureRecognizers><TapGestureRecognizer Tapped="OnEventoDashboardTapped" CommandParameter="{Binding .}" /></Frame.GestureRecognizers>
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                                            <Label Text="{Binding nombre_cliente}" FontSize="16" FontAttributes="Bold" TextColor="#394957" />
                                            <Label Grid.Column="1" Text="{Binding estatus}" FontSize="12" TextColor="#394957" />
                                            <HorizontalStackLayout Grid.Row="1" Spacing="8"><Label Text="📅" FontSize="13" /><Label Text="{Binding FechaFormateada}" FontSize="13" TextColor="#8FA7B8" /><Label Text="👥" FontSize="13" /><Label Text="{Binding tipo_evento}" FontSize="13" TextColor="#8FA7B8" /></HorizontalStackLayout>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>


                <Frame Grid.Row="1" BackgroundColor="White" BorderColor="#DCE4EC" CornerRadius="16" Padding="16" HasShadow="False">
                    <VerticalStackLayout x:Name="PanelAlertasPagos" Spacing="10">
                        <Label Text="🔔  Alertas de pagos próximos" FontSize="18" FontAttributes="Bold" TextColor="#394957" />
                        <CollectionView x:Name="ColeccionAlertas" HeightRequest="260" SelectionMode="None">
                            <CollectionView.EmptyView><Label Text="No hay alertas de pago." TextColor="#8FA7B8" HorizontalOptions="Center" VerticalOptions="Center" /></CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="#F4E1E5" BorderColor="#EBCBD2" CornerRadius="12" Padding="14" Margin="0,0,0,8" HasShadow="False">
                                        <VerticalStackLayout Spacing="4"><Label Text="{Binding Cliente}" FontAttributes="Bold" TextColor="#394957" /><Label Text="{Binding MensajeAlerta}" FontSize="12" TextColor="#B05E68" /></VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Grid x:Name="ModalStaffEvento" IsVisible="False" BackgroundColor="#80000000" Padding="24" ZIndex="20">
                <Frame BackgroundColor="White" CornerRadius="16" Padding="20" VerticalOptions="Center" HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Detalle del evento" FontSize="20" FontAttributes="Bold" TextColor="#394957" />
                        <Label x:Name="LblModalStaffCliente" TextColor="#394957" /><Label x:Name="LblModalStaffTipoEvento" TextColor="#394957" /><Label x:Name="LblModalStaffFecha" TextColor="#394957" /><Label x:Name="LblModalStaffPersonas" TextColor="#394957" /><Label x:Name="LblModalStaffObservaciones" TextColor="#394957" /><Label x:Name="LblModalStaffRol" TextColor="#394957" /><Label x:Name="LblModalStaffPuesto" TextColor="#394957" /><Label x:Name="LblModalStaffDescripcionRol" TextColor="#394957" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>