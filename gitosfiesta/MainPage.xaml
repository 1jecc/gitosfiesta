<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gitosfiesta.MainPage"
             BackgroundColor="#E9F7F8">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,40,30,30"
            Spacing="25"
            HorizontalOptions="Center"
            MaximumWidthRequest="500">

            <!-- Logotipo de Gitos Fiesta -->
            <Image
                Source="logo_login.jpeg"
                HeightRequest="200"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <!-- Título Principal -->
            <Label
                Text="¡Bienvenido a Gitos Fiesta!"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#1A3C40"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <!-- Descripción de bienvenida -->
            <Label
                Text="Sistema de gestión y control de eventos. Utiliza el menú lateral para navegar entre las diferentes secciones."
                FontSize="15"
                TextColor="#7A8B8E"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineHeight="1.2" />

            <!-- Tarjeta o botón de acción rápida -->


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>